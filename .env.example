# Port to run the server on
PORT=3000

# Server-side API Keys (optional; can be entered securely in the client UI instead)
GEMINI_API_KEY=
GPT_API_KEY=
CLAUDE_API_KEY=

# Server-side model overrides (optional; models listed may be outdated)
GEMINI_MODEL=gemini-2.5-flash
GPT_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-20241022
